<!DOCTYPE html>
<html>
<head>
  <title>Question Management</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <%# Shared site chrome appears on every page %>
  <%- include('../partials/banner.ejs') %>

  <%- include('../partials/adminNav.ejs') %>

  <main class="page-shell page-shell--centered">
    <section class="page-card">
      <section class="page-card table-card">
        <h1 class="page-title">Question Types</h1>
          <table class="data-table">
            <thead>
              <tr>
                <th>Question Type ID</th>
                <th>Question Type</th>
                <th>Unit</th>
                <th>Data Type</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% questions.forEach((entry) => { %>
                <tr>
                  <td><%= entry.id %></td>
                  <td><%= entry.name.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %></td>
                  <td><%= entry.unit %></td>
                  <td><%= entry.data_type %></td>
                    <td>
                        <form action="/admin/questionManagement/delete/<%= entry.id %>" method="POST" style="display:inline;">
                            <button class="button button-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </section>
      </section>
      <br>
      <section class="page-card page-card--compact">
        <h2 class="page-title">Add Question Type ID</h2>
        <form class="stacked-form" action="/admin/questionManagement/add" method="POST">
            <div class="form-group">
                <label class="form-label" for="question-type">Question Type:</label>
                <input class="form-input" type="text" id="question-type" name="name" placeholder="Question type" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="unit">Unit:</label>
                <input class="form-input" type="text" id="unit" name="unit" placeholder="Unit" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="data-type">Data Type:</label>
                <select class="form-input" id="data-type" name="data_type" required>
                    <option value="">-- Select type --</option>
                    <option value="number">Number</option>
                    <option value="text">Text</option>
                    <option value="boolean">Boolean</option>
                </select>
            </div>
            <button class="button button-primary" type="submit">Add Question Type</button>
        </form>
      </section>
    </main>

</body>
</html>
