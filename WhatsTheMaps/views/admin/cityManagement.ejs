<!DOCTYPE html>
<html>
<head>
  <title>City Management</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <%# Shared site chrome appears on every page %>
  <%- include('../partials/banner.ejs') %>

  <%- include('../partials/adminNav.ejs') %>

  <main class="page-shell page-shell--centered">
    <div class="section-stack">
      <%# First table with user players %>
      <section class="page-card table-card" style="width: 100%; overflow-x: auto;">
        <h1 class="page-title">Cities</h1>

          <table class="data-table">
            <thead>
              <tr>
                <th>City ID</th>
                <th>City Name</th>
                <th>State </th>
                <% factTypes.forEach(ft => { %>
                    <th><%= ft.name %></th>
                <% }) %>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% cities.forEach((city) => { %>
                <tr>
                  <td><%= city.id %></td>
                  <td><%= city.name %></td>
                  <td><%= city.state %></td>
                  <% factTypes.forEach(ft => { %>
                    <td><%= city.facts[ft.name] || '-' %></td>
                  <% }) %>
                  <td>
                      <form action="/admin/cityManagement/delete/<%= city.id %>" method="POST" style="display:inline;">
                          <button class="button button-danger" type="submit">Delete</button>
                      </form>
                  </td>
                </tr>
                <% }) %>
            </tbody>
          </table>
    </section>
    <section class="page-card page-card--compact">
        <h2 class="page-title">Add City</h2>
        <form class="stacked-form" action="/admin/cityManagement/add" method="POST">
            <div class="form-group">
                <label class="form-label" for="city-name">City Name:</label>
                <input class="form-input" type="text" id="city-name" name="name" placeholder="City name" required>
            </div>
            <div class="form-group">
                <label class="form-label" for="state">State:</label>
                <input class="form-input" type="text" id="state" name="state" placeholder="State" required>
            </div>
            <button class="button button-primary" type="submit">Add City</button>
        </form>
    </section>
    </div>
  </main>

</body>
</html>
