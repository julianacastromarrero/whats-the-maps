<!DOCTYPE html>
<html>
<head>
  <title>User Management</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <%# Shared site chrome appears on every page %>
  <%- include('../partials/banner.ejs') %>

  <%- include('../partials/adminNav.ejs') %>

  <main class="page-shell page-shell--centered">
    <div class="section-stack">
      <%# Second table with user admin %>
      <section class="page-card table-card">
        <h1 class="page-title">Players</h1>

          <table class="data-table">
            <thead>
              <tr>
                <th>User ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Bio</th>
                <th>Creation Date</th>
                <th>Deleted?</th>
                <th>Actions</th>

              </tr>
            </thead>
            <tbody>
              <% players.forEach((entry, index) => { %>
                <tr>
                  <td><%= entry.user_id %></td>
                  <td><%= entry.username %></td>
                  <td><%= entry.email %></td>
                  <td><%= entry.bio || '-' %></td>
                  <td><%= entry.created_at ? new Date(entry.created_at).toLocaleDateString() : '-' %></td>
                  <td><%= entry.deleted ? 'Yes' : 'No' %></td>
                  <td>
                    <% if (!entry.deleted) { %>
                    <form action="/admin/userManagement/delete/<%= entry.user_id %>" method="POST" style="display:inline;">
                        <button class="button button-danger" type="submit">Delete</button>
                    </form>
                    <form action="/admin/userManagement/makeAdmin/<%= entry.user_id %>" method="POST" style="display:inline;">
                      <button class="button button-secondary" type="submit">Make Admin</button>
                  </form>
                    <% } else { %>
                    <form action="/admin/userManagement/undelete/<%= entry.user_id %>" method="POST" style="display:inline;">
                        <button class="button button-secondary" type="submit">Undelete</button>
                    </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
      </section>
      <%# Second table with user admins %>
      <section class="page-card table-card">
        <h1 class="page-title">Admins</h1>

          <table class="data-table">
            <thead>
              <tr>
                <th>User ID</th>
                <th>Username</th>
                <th>Email</th>
                <th>Creation Date</th>
              </tr>
            </thead>
            <tbody>
              <% admins.forEach((entry, index) => { %>
                <tr>
                  <td><%= entry.user_id %></td>
                  <td><%= entry.username %></td>
                  <td><%= entry.email %></td>
                  <td><%= entry.created_at ? new Date(entry.created_at).toLocaleDateString() : '-' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
      </section>
    </div>
  </main>

</body>
</html>